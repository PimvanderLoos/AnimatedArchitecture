<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>nl.pim16aap2.animatedarchitecture</groupId>
        <artifactId>animatedarchitecture-testing</artifactId>
        <version>0.8.0-SNAPSHOT</version>
    </parent>
    <artifactId>animatedarchitecture-lightkeeper-e2e</artifactId>
    <description>Tests the actual packaged AnimatedArchitecture plugin on a real Minecraft server.</description>
    <properties>
        <project.root-dir>${project.basedir}/../..</project.root-dir>
        <vault.version>1.7.3</vault.version>
        <vault.sha256>a6b5ed97f43a5cf5bbaf00a7c8cd23c5afc9bd003f849875af8b36e6cf77d01d</vault.sha256>
    </properties>
    <dependencies>
        <dependency>
            <groupId>nl.pim16aap2.animatedarchitecture</groupId>
            <artifactId>spigot-packager</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>nl.pim16aap2.lightkeeper</groupId>
            <artifactId>lightkeeper-junit-starter</artifactId>
            <version>${version.lightkeeper}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>nl.pim16aap2.lightkeeper</groupId>
                <artifactId>lightkeeper-maven-plugin</artifactId>
                <version>${version.lightkeeper}</version>
                <configuration>
                    <pluginUnderTest>
                        <artifactId>spigot-packager</artifactId>
                    </pluginUnderTest>
                    <plugins>
                        <plugin>
                            <sourceType>url</sourceType>
                            <url>https://github.com/MilkBowl/Vault/releases/download/${vault.version}/Vault.jar</url>
                            <sha256>${vault.sha256}</sha256>
                            <renameTo>Vault.jar</renameTo>
                        </plugin>
                    </plugins>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-lightkeeper</id>
                        <goals>
                            <goal>prepare-server</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${version.surefire}</version>
                <configuration>
                    <failIfNoTests>true</failIfNoTests>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
